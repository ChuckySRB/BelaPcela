{
  "name": "belapcela",
  "private": true,
  "version": "1.0.0",
  "description": "БелаПчела — a private, offline family tree and family archive in Serbian Cyrillic.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ChuckySRB/BelaPcela.git" },
  "bugs": { "url": "https://github.com/ChuckySRB/BelaPcela/issues" },
  "engines": { "node": "^22.13.0 || ^24.0.0 || >=26.0.0" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/third-party-notices.mjs --check",
    "licenses": "node scripts/third-party-notices.mjs",
    "check": "npm test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:static": "node scripts/smoke-static.mjs",
    "test:e2e": "playwright test",
    "test:offline": "playwright test -c playwright.offline.config.ts"
  },
  "dependencies": {
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "dexie": "^4.4.7",
    "elkjs": "^0.12.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
